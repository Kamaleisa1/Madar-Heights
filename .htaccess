# Hostinger: إذا رفعت المشروع كله داخل public_html، الملف ده بيحوّل كل الطلبات لمجلد public
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# امنع الوصول المباشر للملفات الحساسة
<FilesMatch "^\.env|composer\.(json|lock)|artisan$">
    Require all denied
</FilesMatch>
